<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="800" Height="450"
        x:Class="FlightDispatcher.MainWindow"
        Title="FlightDispatcher">
    <Window.Styles>
        <Style Selector="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBox, ComboBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox.items">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="16,0"/>
            <Setter Property="SelectionMode" Value="Single, Toggle"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Styles>
    
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            
            <Grid>
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
            </Grid>
            <StackPanel x:Name="SpFlightForm" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Flight Id:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtFlightId"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Label Content="Airline:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtAirline"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Label Content="Origin:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtOrigin"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Label Content="Flight Id:" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtFlightId"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
