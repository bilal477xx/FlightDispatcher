<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:FlightDispatcher.Models"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="920" Height="600" WindowStartupLocation="CenterScreen"
        RequestedThemeVariant="Light"
        Closing="Window_OnClosing"
        x:Class="FlightDispatcher.MainWindow"
        Title="FlightDispatcher">
    <Window.Styles>
        <Style Selector="DataValidationErrors">
            <Setter Property="ErrorTemplate">
                <DataTemplate x:CompileBindings="False">
                    <ItemsControl ItemsSource="{Binding}" Foreground="Red">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:Exception">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </Setter>
        </Style>
        
        <Style Selector="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBox, ComboBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="300"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ListBox.items">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="SelectionMode" Value="Single, Toggle"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
    </Window.Styles>
    
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem x:Name="MnuNew" Header="New" Click="MnuNew_OnClick"/>
                <MenuItem x:Name="MnuOpen" Header="Open"/>
                <MenuItem x:Name="MnuSave" Header="Save" Click="MnuSave_OnClick"/>
                <MenuItem x:Name="MnuSaveAs" Header="Save As" Click="MnuSaveAs_OnClick"/>
                <MenuItem x:Name="MnuLoad" Header="Load" Click="MnuLoad_OnClick"/>
            </MenuItem>
        </Menu>
        
        <Grid RowSpacing="16" Margin="16 8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Row="0" Grid.Column="0" ColumnSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Grid x:Name="FlightForm" x:DataType="models:Flight" Grid.Row="0" Grid.Column="0" RowSpacing="8" ColumnSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Label Grid.Row="0" Grid.Column="0" Content="Flight Id:" VerticalAlignment="Top" Padding="0 8 0 0"/>
                    <TextBox x:Name="TxtFlightId" Grid.Row="0" Grid.Column="1" Text="{Binding FlightId}"/>
                    
                    <Label Grid.Row="1" Grid.Column="0"  Content="Airline:" VerticalAlignment="Top" Padding="0 8 0 0"/>
                    <TextBox x:Name="TxtAirline" Grid.Row="1" Grid.Column="1" Text="{Binding Airline}"/>
                    
                    <Label Grid.Row="2" Grid.Column="0"  Content="Origin:" VerticalAlignment="Top" Padding="0 8 0 0"/>
                    <TextBox x:Name="TxtOrigin" Grid.Row="2" Grid.Column="1" Text="{Binding Origin}"/>
                    
                    <Label Grid.Row="3" Grid.Column="0"  Content="Destination:" VerticalAlignment="Top" Padding="0 8 0 0"/>
                    <TextBox x:Name="TxtDestination" Grid.Row="3" Grid.Column="1" Text="{Binding Destination}"/>
                    
                    <Label Grid.Row="4" Grid.Column="0"  Content="Flight Duration:" VerticalAlignment="Top" Padding="0 8 0 0"/>
                    <TextBox x:Name="TxtFlightDuration" Grid.Row="4" Grid.Column="1" Text="{Binding FlightDuration}"/>
                </Grid>
                
                <ListBox x:Name="LbFlights" Grid.Row="0" Grid.Column="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnAddFlight" Click="BtnAddFlight_OnClick" Content="Add Plane" Padding="24 12"/>
                <Button x:Name="BtnTakeOff" Click="BtnTakeOff_OnClick" Content="Take Off" Padding="24 12"/>
            </StackPanel>
            
            <ListBox x:Name="LbFlightUpdates" Grid.Row="2" Grid.Column="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
